---
import { getProblem } from '~/src/content/boj';

import StatementSingle from './StatementSingle.astro';

type Props = {
	prob: number,
	hideTitle?: boolean,
};
const { prob, hideTitle = false } = Astro.props;
const problem = getProblem(prob);
if(!problem)
	throw new ReferenceError(`problem #${prob} not available`);

const stmtOrder: string[] = [problem.original];
if(problem.korean !== undefined && problem.korean !== problem.original)
	stmtOrder.push(problem.korean);
for(const k of Object.keys(problem.statement))
	if(k !== problem.original && k !== problem.korean)
		stmtOrder.push(k);
---

<article class="block-element visual-block">
	<StatementSingle problem={problem} lang={stmtOrder[0]} hideTitle={hideTitle} />
</article>